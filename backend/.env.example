# Copier en .env (jamais commité) puis adapter.
APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL local (Homebrew / pgAdmin) :
DATABASE_URL=postgres:///samacode?host=/tmp
# PostgreSQL via docker compose :
# DATABASE_URL=postgres://samacode:samacode@localhost:5432/samacode?sslmode=disable

AUTO_MIGRATE=true
TRUST_PROXY_HEADERS=false
# Documentation Swagger sur /docs (par défaut : activée hors production).
# API_DOCS=true

# Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_SECRET=change-me-too-change-me-too-change-me-too

# log = le code SMS s'affiche dans les journaux (dev uniquement). Fournisseur réel : Q12.
SMS_PROVIDER=log

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
